// Shipped as go.mod.dist rather than go.mod on purpose.
//
// This is a developer tool, not a simulator: it regenerates the checked-in
// fixtures and never ships in the simulator image. It needs a local checkout
// of the go-ethereum PBT fork, whose trie/bintrie package recomputes PBT
// roots for the mutations that have to reach past the internal-consistency
// check. CI has no such checkout, and hive's simulator build walks every
// go.mod under simulators/, so leaving one here would break a build that has
// nothing to do with this code.
//
// To regenerate, copy it into place first:
//
//	cp go.mod.dist go.mod && go mod tidy
//	go run . -geth /path/to/geth -out ..
//
// The replace path assumes hive and go-ethereum are siblings.
module github.com/ethereum/hive/simulators/ethereum/pbt-artifacts/fixtures/gen

go 1.24.0

require github.com/ethereum/go-ethereum v1.16.4

replace github.com/ethereum/go-ethereum => ../../../../../../go-ethereum
